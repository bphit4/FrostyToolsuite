<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="2.27.3" />
    <PackageReference Include="HelixToolkit.SharpDX.Assimp" Version="2.27.3" />
    <Reference Include="HelixToolkit.Wpf.SharpDX.Assimp">
      <HintPath>$(NuGetPackageRoot)helixtoolkit.sharpdx.assimp\2.27.3\lib\net46\HelixToolkit.Wpf.SharpDX.Assimp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
