<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FrostyEditor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="640"
             x:Class="FrostyEditor.Views.ProfileSelectView"
             x:DataType="viewModels:ProfileSelectViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.profile-card">
      <Setter Property="Background" Value="#2B2B31"/>
      <Setter Property="BorderBrush" Value="#43434A"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.profile-card">
      <Setter Property="BorderBrush" Value="#5A5A62"/>
    </Style>
    <Style Selector="ListBoxItem:selected Border.profile-card">
      <Setter Property="Background" Value="#98271E"/>
      <Setter Property="BorderBrush" Value="#C84A36"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="10">
    <Border Grid.Row="0" Classes="surface" Padding="2" Margin="0,0,0,6" Height="170" ClipToBounds="True">
      <Image Source="avares://FrostyEditor/Assets/ProfileBanner.png"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Stretch="UniformToFill"/>
    </Border>

    <Border Grid.Row="1" Classes="surface" Padding="10">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="Bold"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 MinHeight="330"
                 HorizontalAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 DoubleTapped="ProfilesList_OnDoubleTapped"
                 IsEnabled="{Binding CanEditProfiles}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="panel profile-card" Margin="0" Padding="8">
                <Grid ColumnDefinitions="180,*">
                  <Border Width="180" Height="56" CornerRadius="4" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                      <Image Source="{Binding Banner}"
                             Stretch="UniformToFill"
                             IsVisible="{Binding HasBanner}"/>
                      <Border Background="#252526" IsVisible="{Binding ShowFallbackIcon}">
                        <Image Source="{Binding FallbackIcon}"
                               Width="26"
                               Height="26"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Path}" Classes="subtle" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,8,0,0">
          <Button Grid.Column="0" Content="{StaticResource ID_PROFILE_CANCEL}" Command="{Binding CancelCommand}" HorizontalAlignment="Left"/>
          <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveProfileCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}"/>
          <Button Grid.Column="2" Content="{StaticResource ID_PROFILE_ADD}" Command="{Binding AddProfileCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanEditProfiles}"/>
          <Button Grid.Column="3" Classes="primary" Content="{StaticResource ID_PROFILE_SELECT}" Command="{Binding SelectProfileCommand}" Margin="8,0,0,0" IsEnabled="{Binding CanInteract}"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Classes="panel"
            Margin="0,6,0,0"
            Padding="10,8">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Startup Status"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{Binding StartupStatus}"
                     Classes="subtle"
                     TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding ProfileCountText}"
                   Classes="subtle"
                   VerticalAlignment="Bottom"
                   Margin="16,0,0,0"/>
        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              ColumnDefinitions="*,Auto"
              Margin="0,10,0,0"
              IsVisible="{Binding IsBusy}">
          <ProgressBar Minimum="0"
                       Maximum="1"
                       Value="{Binding StartupLogger.ProgressValue}"
                       IsIndeterminate="{Binding IsStartupProgressIndeterminate}"
                       Height="8"
                       VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1"
                     Margin="12,0,0,0"
                     Text="{Binding StartupLogger.ProgressPercentText}"
                     Classes="subtle"
                     VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0"
                Padding="8"
                CornerRadius="6"
                Background="#0E1520"
                BorderBrush="#2A3444"
                BorderThickness="1"
                IsVisible="{Binding IsBusy}">
          <ItemsControl ItemsSource="{Binding StartupSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                  <TextBlock Text="{Binding StatePrefix}"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             Opacity="0.8"/>
                  <TextBlock Grid.Column="1"
                             Margin="10,0,0,0"
                             Text="{Binding DisplayName}"
                             FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="2"
                             Margin="10,0,0,0"
                             Text="{Binding StatusMessage}"
                             Opacity="0.7"
                             IsVisible="{Binding HasStatusMessage}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <Border Grid.Row="3"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0"
                Padding="8"
                CornerRadius="6"
                Background="#0E1520"
                BorderBrush="#2A3444"
                BorderThickness="1"
                IsVisible="{Binding HasStartupLog}">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="{Binding StartupLogger.LastEntry}"
                       Classes="subtle"
                       TextWrapping="Wrap"/>
            <TextBox Grid.Row="1"
                     Margin="0,8,0,0"
                     Text="{Binding StartupLogger.Text}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="11"
                     MinHeight="96"
                     MaxHeight="140"
                     BorderBrush="#3F3F46"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
