<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FrostyEditor.Controls"
             xmlns:viewModels="clr-namespace:FrostyEditor.ViewModels"
             xmlns:models="clr-namespace:FrostyEditor.Models"
             mc:Ignorable="d"
             x:Class="FrostyEditor.Views.MeshAssetEditorView"
             x:Name="Root"
             x:DataType="viewModels:MeshAssetEditorViewModel"
             d:DesignWidth="1380"
             d:DesignHeight="860"
             Tag="{Binding InspectorNameColumnWidth}">
  <UserControl.Resources>
    <DataTemplate x:Key="InspectorNameTemplate"
                  DataType="models:InspectorNodeModel">
      <Grid
            Height="18"
            ClipToBounds="True"
            PointerPressed="OnInspectorRowPointerPressed"
            ContextRequested="OnInspectorContextRequested">
        <Grid.ContextFlyout>
          <MenuFlyout>
            <MenuItem Header="Copy Value" Tag="copy" Click="OnCopyMenuItemClick"/>
            <Separator Tag="expand-separator" IsVisible="False"/>
            <MenuItem Header="Expand All One Level" Tag="expand-one-level" Click="OnExpandOneLevelMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Expand All Levels" Tag="expand-all-levels" Click="OnExpandAllLevelsMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Collapse All One Level" Tag="collapse-one-level" Click="OnCollapseOneLevelMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Collapse All Levels" Tag="collapse-all-levels" Click="OnCollapseAllLevelsMenuItemClick" IsVisible="False"/>
            <Separator Tag="ref-separator" IsVisible="False"/>
            <MenuItem Header="Copy Guid" Tag="copy-guid" Click="OnCopyGuidMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Open Asset" Tag="open-asset" Click="OnOpenReferenceAssetMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Find In Data Explorer" Tag="find-asset" Click="OnFindReferenceAssetMenuItemClick" IsVisible="False"/>
          </MenuFlyout>
        </Grid.ContextFlyout>
      <Border Background="Transparent"
              Padding="2,0,6,0"
              Height="22"
              ClipToBounds="True">
        <Grid ColumnDefinitions="16,*"
              Margin="{Binding FlatNameIndent}">
          <Path Grid.Column="0"
                Width="6"
                Height="6"
                Fill="#DADADA"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{Binding ExpandGlyphData}"
                  IsVisible="{Binding ShowExpandGlyph}"/>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#F2F2F2"
                       FontFamily="Global User Interface"
                       FontSize="11"
                       LineHeight="14"
                       FontWeight="{Binding NameFontWeight}"
                       ClipToBounds="True"
                       TextWrapping="NoWrap">
              <Run Text="{Binding Name}"/>
              <Run Text="{Binding NameSuffix}"/>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="InspectorValueTemplate"
                  DataType="models:InspectorNodeModel">
      <Grid
            Height="18"
            ClipToBounds="True"
            PointerPressed="OnInspectorRowPointerPressed"
            ContextRequested="OnInspectorContextRequested">
        <Grid.ContextFlyout>
          <MenuFlyout>
            <MenuItem Header="Copy Value" Tag="copy" Click="OnCopyMenuItemClick"/>
            <Separator Tag="expand-separator" IsVisible="False"/>
            <MenuItem Header="Expand All One Level" Tag="expand-one-level" Click="OnExpandOneLevelMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Expand All Levels" Tag="expand-all-levels" Click="OnExpandAllLevelsMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Collapse All One Level" Tag="collapse-one-level" Click="OnCollapseOneLevelMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Collapse All Levels" Tag="collapse-all-levels" Click="OnCollapseAllLevelsMenuItemClick" IsVisible="False"/>
            <Separator Tag="ref-separator" IsVisible="False"/>
            <MenuItem Header="Copy Guid" Tag="copy-guid" Click="OnCopyGuidMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Open Asset" Tag="open-asset" Click="OnOpenReferenceAssetMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Find In Data Explorer" Tag="find-asset" Click="OnFindReferenceAssetMenuItemClick" IsVisible="False"/>
          </MenuFlyout>
        </Grid.ContextFlyout>
        <Border
                Background="Transparent"
                Padding="6,0,6,0"
                Height="18"
                ClipToBounds="True">
          <Grid ColumnDefinitions="*,Auto">
            <CheckBox IsVisible="{Binding IsBooleanVisible}"
                      Classes="compact-checkbox"
                      IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Margin="0"
                      Padding="0"/>
            <StackPanel IsVisible="{Binding IsPointerDisplayVisible}"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
              <Button Width="14"
                      Height="16"
                      Padding="0"
                      Margin="0"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsVisible="{Binding CanAssignFromSelectedAsset}"
                      ToolTip.Tip="Assign from selected asset"
                      Click="OnAssignPointerFromSelectedAssetClicked">
                <Path Width="10"
                      Height="12"
                      Fill="#F0F0F0"
                      Stretch="Uniform"
                      Data="M0 6 L4 6 L4 2 L10 7 L4 12 L4 8 L0 8 Z"/>
              </Button>
              <Image Source="{Binding PointerTypeIcon}"
                     Width="12"
                     Height="12"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding PointerTypeName}"/>
              <StackPanel Orientation="Horizontal"
                          Spacing="4"
                          VerticalAlignment="Center">
                <TextBlock Classes="inspector-value-text"
                           Text="{Binding PointerDisplayName}"
                           ToolTip.Tip="{Binding PointerGuidText}"
                           FontWeight="{Binding NameFontWeight}"
                           VerticalAlignment="Center"/>
                <TextBlock Classes="inspector-value-text"
                           Text="{Binding PointerDisplayPath, StringFormat=({0})}"
                           Foreground="#A7A7A7"
                           IsVisible="{Binding ShowPointerDisplayPath}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="inspector-value-text"
                       Text="{Binding Value}"
                       IsVisible="{Binding IsTextVisible}"
                       FontWeight="{Binding NameFontWeight}"
                       VerticalAlignment="Center"/>
            <TextBox Classes="inspector-editor"
                     Text="{Binding EditorText, Mode=TwoWay}"
                     IsVisible="{Binding IsEditorVisible}"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Left"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="10"
                     Padding="0"
                     Margin="0"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     Height="16"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     PointerPressed="OnInspectorEditorPointerPressed"
                     ContextRequested="OnInspectorEditorContextRequested"
                     LostFocus="OnInspectorEditorLostFocus"
                     KeyDown="OnInspectorEditorKeyDown"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="6,0,2,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ShowRowActions}">
              <Button Classes="inspector-action-button"
                      Width="17"
                      Height="17"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsVisible="{Binding CanClearCollectionItems}"
                      Click="OnClearCollectionItemsClicked">
                <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Remove.png"
                       Width="14"
                       Height="14"/>
              </Button>
              <Button Classes="inspector-action-button"
                      Width="17"
                      Height="17"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsVisible="{Binding CanRemoveCollectionEntry}"
                      Click="OnRemoveCollectionEntryClicked">
                <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Remove.png"
                       Width="14"
                       Height="14"/>
              </Button>
              <Button Classes="inspector-action-button"
                      Width="17"
                      Height="17"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsVisible="{Binding CanAddCollectionItem}"
                      Click="OnAddCollectionItemClicked">
                <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Add.png"
                       Width="14"
                       Height="14"/>
              </Button>
              <Button Classes="inspector-action-button"
                      Width="17"
                      Height="17"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsVisible="{Binding ShowPointerOptions}"
                      Click="OnPointerOptionsClicked">
                <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/More.png"
                       Width="14"
                       Height="14"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="InspectorRowTemplate"
                  DataType="models:InspectorNodeModel">
      <Grid Height="22"
            ClipToBounds="True"
            PointerPressed="OnInspectorRowPointerPressed"
            ContextRequested="OnInspectorContextRequested">
        <Grid.ContextFlyout>
          <MenuFlyout>
            <MenuItem Header="Copy Value" Tag="copy" Click="OnCopyMenuItemClick"/>
            <Separator Tag="expand-separator" IsVisible="False"/>
            <MenuItem Header="Expand All One Level" Tag="expand-one-level" Click="OnExpandOneLevelMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Expand All Levels" Tag="expand-all-levels" Click="OnExpandAllLevelsMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Collapse All One Level" Tag="collapse-one-level" Click="OnCollapseOneLevelMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Collapse All Levels" Tag="collapse-all-levels" Click="OnCollapseAllLevelsMenuItemClick" IsVisible="False"/>
            <Separator Tag="ref-separator" IsVisible="False"/>
            <MenuItem Header="Copy Guid" Tag="copy-guid" Click="OnCopyGuidMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Open Asset" Tag="open-asset" Click="OnOpenReferenceAssetMenuItemClick" IsVisible="False"/>
            <MenuItem Header="Find In Data Explorer" Tag="find-asset" Click="OnFindReferenceAssetMenuItemClick" IsVisible="False"/>
          </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0"
                  Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Background="Transparent"
                  Padding="1,0,6,0"
                  Height="22"
                  ClipToBounds="True">
            <Grid ColumnDefinitions="*"
                  Margin="{Binding NameIndent}">
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         Foreground="#F2F2F2"
                         FontSize="11"
                         LineHeight="14"
                         FontWeight="{Binding NameFontWeight}"
                         ClipToBounds="True"
                         TextWrapping="NoWrap">
                <Run Text="{Binding Name}"/>
                <Run Text="{Binding NameSuffix}"/>
              </TextBlock>
            </Grid>
          </Border>
          <Border Grid.Column="1"
                  Background="Transparent"
                  Padding="6,0,10,0"
                  Height="22"
                  ClipToBounds="False">
            <Grid ColumnDefinitions="*,Auto">
              <CheckBox IsVisible="{Binding IsBooleanVisible}"
                        Classes="compact-checkbox"
                        IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="0"
                        Padding="0"/>
              <StackPanel IsVisible="{Binding IsPointerDisplayVisible}"
                          Orientation="Horizontal"
                          Spacing="4"
                          VerticalAlignment="Center">
                <Button Width="14"
                        Height="16"
                        Padding="0"
                        Margin="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding CanAssignFromSelectedAsset}"
                        ToolTip.Tip="Assign from selected asset"
                        Click="OnAssignPointerFromSelectedAssetClicked">
                  <Path Width="10"
                        Height="12"
                        Fill="#F0F0F0"
                        Stretch="Uniform"
                        Data="M0 6 L4 6 L4 2 L10 7 L4 12 L4 8 L0 8 Z"/>
                </Button>
                <Image Source="{Binding PointerTypeIcon}"
                       Width="12"
                       Height="12"
                       VerticalAlignment="Center"
                       ToolTip.Tip="{Binding PointerTypeName}"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                  <SelectableTextBlock Classes="inspector-value-text"
                                       Text="{Binding PointerDisplayName}"
                                       ToolTip.Tip="{Binding PointerGuidText}"
                                       FontWeight="{Binding NameFontWeight}"
                                       VerticalAlignment="Center"/>
                  <SelectableTextBlock Classes="inspector-value-text"
                                       Text="{Binding PointerDisplayPath, StringFormat=({0})}"
                                       Foreground="#A7A7A7"
                                       IsVisible="{Binding ShowPointerDisplayPath}"
                                       VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
              <SelectableTextBlock Classes="inspector-value-text"
                                   Text="{Binding Value}"
                                   IsVisible="{Binding IsTextVisible}"
                                   FontWeight="{Binding NameFontWeight}"
                                   VerticalAlignment="Center"/>
              <TextBox Classes="inspector-editor"
                       Text="{Binding EditorText, Mode=TwoWay}"
                       IsVisible="{Binding IsEditorVisible}"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Left"
                       VerticalContentAlignment="Center"
                       VerticalAlignment="Center"
                     FontSize="11"
                       Padding="0"
                       Margin="0"
                       AcceptsReturn="False"
                       TextWrapping="NoWrap"
                     Height="18"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       PointerPressed="OnInspectorEditorPointerPressed"
                       ContextRequested="OnInspectorEditorContextRequested"
                       LostFocus="OnInspectorEditorLostFocus"
                       KeyDown="OnInspectorEditorKeyDown"/>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="4"
                          Margin="8,0,4,0"
                          VerticalAlignment="Center"
                          IsVisible="{Binding ShowRowActions}">
                <Button Classes="inspector-action-button"
                        Width="17"
                        Height="17"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding CanClearCollectionItems}"
                        Click="OnClearCollectionItemsClicked">
                  <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Remove.png"
                         Width="14"
                         Height="14"/>
                </Button>
                <Button Classes="inspector-action-button"
                        Width="17"
                        Height="17"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding CanRemoveCollectionEntry}"
                        Click="OnRemoveCollectionEntryClicked">
                  <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Remove.png"
                         Width="14"
                         Height="14"/>
                </Button>
                <Button Classes="inspector-action-button"
                        Width="17"
                        Height="17"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding CanAddCollectionItem}"
                        Click="OnAddCollectionItemClicked">
                  <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Add.png"
                         Width="14"
                         Height="14"/>
                </Button>
                <Button Classes="inspector-action-button"
                        Width="17"
                        Height="17"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding ShowPointerOptions}"
                        Click="OnPointerOptionsClicked">
                  <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/More.png"
                         Width="14"
                         Height="14"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ListBox.inspector-name-list">
      <Setter Property="Background" Value="#24242A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.inspector-name-list ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False"/>
      <Setter Property="IsScrollInertiaEnabled" Value="False"/>
      <Setter Property="IsScrollChainingEnabled" Value="False"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
    </Style>
    <Style Selector="ListBox.inspector-name-list > ListBoxItem">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#202025"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.inspector-name-list > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.inspector-name-list > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#303030"/>
    </Style>
    <Style Selector="TextBox.mesh-value">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="ListBox.inspector-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,0,14,14"/>
      <Setter Property="Margin" Value="0,0,2,2"/>
    </Style>
    <Style Selector="ListBox.inspector-list ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False"/>
      <Setter Property="IsScrollInertiaEnabled" Value="False"/>
      <Setter Property="IsScrollChainingEnabled" Value="False"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
      <Setter Property="Margin" Value="0,0,1,1"/>
    </Style>
    <Style Selector="ListBox.inspector-list ScrollBar">
      <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ListBox.inspector-list ScrollBar[Orientation=Vertical]">
      <Setter Property="Width" Value="14"/>
      <Setter Property="MinWidth" Value="14"/>
      <Setter Property="MaxWidth" Value="14"/>
    </Style>
    <Style Selector="ListBox.inspector-list ScrollBar[Orientation=Horizontal]">
      <Setter Property="Height" Value="14"/>
      <Setter Property="MinHeight" Value="14"/>
      <Setter Property="MaxHeight" Value="14"/>
    </Style>
    <Style Selector="ListBox.inspector-list > ListBoxItem">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.inspector-list > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.inspector-list > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#303030"/>
    </Style>
    <Style Selector="CheckBox.compact-checkbox">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="MinWidth" Value="14"/>
      <Setter Property="MinHeight" Value="14"/>
      <Setter Property="MaxWidth" Value="14"/>
      <Setter Property="MaxHeight" Value="14"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="CheckBorder"
                  Width="14"
                  Height="14"
                  Background="#232328"
                  BorderBrush="#8A8A90"
                  BorderThickness="1"
                  CornerRadius="0">
            <Path x:Name="CheckGlyph"
                  Width="8"
                  Height="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stroke="#F3F3F3"
                  StrokeThickness="1.75"
                  Stretch="Fill"
                  Opacity="0"
                  Data="M0,3 L2.4,5.6 L8,0"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.compact-checkbox:checked /template/ Path#CheckGlyph">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="CheckBox.compact-checkbox:pointerover /template/ Border#CheckBorder">
      <Setter Property="BorderBrush" Value="#A2A2A8"/>
    </Style>
    <Style Selector="TabControl.inspector-tabs TabItem">
      <Setter Property="Background" Value="#1F1F23"/>
      <Setter Property="BorderBrush" Value="#34343A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,1,0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="TabBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="#F1F1F1"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.inspector-tabs TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight2}"/>
    </Style>
    <Style Selector="TabControl.inspector-tabs TabItem:selected /template/ Border#TabBorder">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight2}"/>
    </Style>
    <Style Selector="TextBox.inspector-editor">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Global User Interface"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="16"/>
      <Setter Property="MaxHeight" Value="16"/>
    </Style>
    <Style Selector="SelectableTextBlock.inspector-value-text">
      <Setter Property="FontFamily" Value="Global User Interface"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.inspector-value-text">
      <Setter Property="FontFamily" Value="Global User Interface"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBox.inspector-editor ScrollViewer">
      <Setter Property="AllowAutoHide" Value="True"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="TextBox.inspector-editor:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.inspector-editor:focus">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.inspector-action-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.inspector-action-button:pointerover">
      <Setter Property="Background" Value="#202025"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.properties-rail-button">
      <Setter Property="Background" Value="#202025"/>
      <Setter Property="BorderBrush" Value="#34343A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootLayoutGrid" RowDefinitions="Auto,*" ColumnDefinitions="*,4,560">
    <Border Grid.ColumnSpan="3" Classes="panel" Padding="4" Margin="0,0,0,4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal"
                    Spacing="3"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
          <Button Classes="toolbar" Command="{Binding ExportMeshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Width="10" Height="10" Stretch="Uniform" Fill="#F0F0F0" Data="M4,0 L6,0 L6,5 L8,5 L5,8 L2,5 L4,5 Z M1,9 L9,9 L9,10 L1,10 Z"/>
              <TextBlock Text="Export" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="toolbar" Command="{Binding ImportMeshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Width="10" Height="10" Stretch="Uniform" Fill="#F0F0F0" Data="M4,8 L6,8 L6,3 L8,3 L5,0 L2,3 L4,3 Z M1,9 L9,9 L9,10 L1,10 Z"/>
              <TextBlock Text="Import" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1"
                  Height="22"
                  Margin="3,0,4,0"
                  Background="#4A4F58"
                  VerticalAlignment="Center" />
          <Button Classes="toolbar" Content="Front" Click="OnFrontViewClick" VerticalAlignment="Center" />
          <Button Classes="toolbar" Content="Back" Click="OnBackViewClick" VerticalAlignment="Center" />
          <Button Classes="toolbar" Content="Left" Click="OnLeftViewClick" VerticalAlignment="Center" />
          <Button Classes="toolbar" Content="Right" Click="OnRightViewClick" VerticalAlignment="Center" />
          <Button Classes="toolbar" Content="Top" Click="OnTopViewClick" VerticalAlignment="Center" />
          <Button Classes="toolbar" Content="Bottom" Click="OnBottomViewClick" VerticalAlignment="Center" />
          <Border Width="1"
                  Height="22"
                  Margin="3,0,4,0"
                  Background="#4A4F58"
                  VerticalAlignment="Center" />
          <TextBlock Text="LOD" Classes="subtle" VerticalAlignment="Center" />
          <ComboBox Width="90"
                    MinWidth="90"
                    Height="26"
                    MinHeight="26"
                    MaxHeight="26"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Lods}"
                    SelectedItem="{Binding SelectedLod, Mode=TwoWay}" />
          <TextBlock Text="Mode" Classes="subtle" VerticalAlignment="Center" />
          <ComboBox Width="112"
                    MinWidth="112"
                    Height="26"
                    MinHeight="26"
                    MaxHeight="26"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding AvailableRenderModes}"
                    SelectedItem="{Binding SelectedRenderMode, Mode=TwoWay}" />
          <TextBlock Text="Channels" Classes="subtle" VerticalAlignment="Center" />
          <ToggleButton Content="R"
                        IsChecked="{Binding RedChannelEnabled, Mode=TwoWay}"
                        MinWidth="30"
                        Width="30"
                        Height="24"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
          <ToggleButton Content="G"
                        IsChecked="{Binding GreenChannelEnabled, Mode=TwoWay}"
                        MinWidth="30"
                        Width="30"
                        Height="24"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
          <ToggleButton Content="B"
                        IsChecked="{Binding BlueChannelEnabled, Mode=TwoWay}"
                        MinWidth="30"
                        Width="30"
                        Height="24"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
          <ToggleButton Content="A"
                        IsChecked="{Binding AlphaChannelEnabled, Mode=TwoWay}"
                        MinWidth="30"
                        Width="30"
                        Height="24"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
          <Border Width="1"
                  Height="22"
                  Margin="3,0,4,0"
                  Background="#4A4F58"
                  VerticalAlignment="Center" />
          <Button Classes="toolbar"
                  Content="Revert"
                  Command="{Binding RevertMeshCommand}"
                  IsVisible="{Binding CanRevert}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Button Classes="toolbar" Content="Reset View" Click="OnResetViewClick" VerticalAlignment="Center" />
          <Button Classes="toolbar" Content="Refresh" Click="OnRefreshViewportClick" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="panel" Padding="2" Margin="0">
      <Grid ColumnDefinitions="*,38">
        <Border Grid.Column="0"
                Background="#171A20"
                BorderBrush="#2F3540"
                BorderThickness="1"
                CornerRadius="0"
                Padding="0"
                ClipToBounds="True">
          <Grid>
            <controls:WindowsMeshViewportHost x:Name="Viewport3D"
                                              IsVisible="{Binding ShowGpuViewport}" />
            <ScrollViewer IsVisible="{Binding ShowSoftwarePreview}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <Image Source="{Binding PreviewBitmap}"
                     IsVisible="{Binding HasPreviewBitmap}"
                     Stretch="None"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <Button Grid.Column="1"
                x:Name="CollapsedInspectorButton"
                Classes="properties-rail-button"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0"
                Width="38"
                Padding="0"
                ZIndex="20"
                Click="OnPropertiesPaneToggleClicked"
                IsVisible="False">
          <Grid RowDefinitions="34,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock x:Name="CollapsedInspectorArrow"
                       Text="&lt;"
                       FontFamily="Arial"
                       FontWeight="Bold"
                       FontSize="15"
                       Margin="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="CollapsedInspectorLabel"
                       Grid.Row="1"
                       Text="P&#10;R&#10;O&#10;P&#10;E&#10;R&#10;T&#10;I&#10;E&#10;S"
                       FontFamily="Arial"
                       FontWeight="Bold"
                       FontSize="14"
                       TextAlignment="Center"
                       LineHeight="14"
                       Margin="0,4,0,8"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="True"/>
          </Grid>
        </Button>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="1"
                  Grid.Column="1"
                  x:Name="InspectorPaneSplitter"
                  Width="4"
                  Background="#3B3B3B"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Columns"/>

    <Border Grid.Row="1" Grid.Column="2" x:Name="InspectorPane" Classes="panel" Padding="0">
        <Grid x:Name="InspectorPaneContent" RowDefinitions="Auto,*">
          <Border Background="Transparent" Padding="0,0,0,4">
            <Border.ContextFlyout>
              <MenuFlyout>
                <MenuItem Header="Expand" Click="OnPropertiesExpandMenuClicked"/>
                <MenuItem Header="Collapse" Click="OnPropertiesCollapseMenuClicked"/>
                <MenuItem Header="Undock (Float Mode)" Click="OnPropertiesFloatMenuClicked"/>
                <MenuItem Header="Dock" Click="OnPropertiesDockMenuClicked"/>
                <Separator/>
                <MenuItem Header="Reset to Default Dock Location" Click="OnPropertiesResetDockMenuClicked"/>
              </MenuFlyout>
            </Border.ContextFlyout>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="toolbar" Width="24" Height="22" Padding="0" Margin="0,0,6,0" Click="OnPropertiesFloatButtonClicked" ToolTip.Tip="Undock Properties">
                <TextBlock Text="[]" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
            </Grid>
          </Border>
          <TabControl Grid.Row="1" Classes="inspector-tabs" SelectionChanged="OnInspectorTabSelectionChanged">
          <TabItem Header="Properties">
            <Grid RowDefinitions="Auto,*" Margin="0,4,0,0">
              <TextBox Classes="search-box"
                       Watermark="Filter"
                       Margin="0,0,0,4"
                       Text="{Binding PropertiesFilterText, Mode=TwoWay}"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,6,*" ClipToBounds="True">
                <Border Width="{Binding InspectorNameColumnWidth}"
                        Background="#24242A"/>
                  <Border Grid.Column="1"
                          Background="Transparent"
                        Cursor="SizeWestEast"
                        PointerPressed="OnInspectorGripPressed"
                        PointerMoved="OnInspectorGripMoved"
                        PointerReleased="OnInspectorGripReleased"
                        ZIndex="10">
                    <Border Width="1"
                            Background="#3A3A40"
                            HorizontalAlignment="Center"/>
                  </Border>
                  <Border Grid.Column="2"
                          Background="#17181B"/>
                  <ListBox x:Name="PropertyInspectorNameList"
                           Grid.Column="0"
                           Classes="inspector-name-list"
                           Width="{Binding InspectorNameColumnWidth}"
                           ItemsSource="{Binding PropertyVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorNameTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                  <ListBox x:Name="PropertyInspectorValueList"
                           Grid.Column="2"
                           Classes="inspector-list"
                           ItemsSource="{Binding PropertyVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorValueTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Variations">
            <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
              <ComboBox ItemsSource="{Binding Variations}"
                        SelectedItem="{Binding SelectedVariation, Mode=TwoWay}"
                        IsEnabled="{Binding HasVariations}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Grid.Row="1"
                       Classes="search-box"
                       Watermark="Filter"
                       Margin="0,6,0,6"
                       Text="{Binding VariationsFilterText, Mode=TwoWay}"/>
              <Grid Grid.Row="2" ColumnDefinitions="Auto,8,*" ClipToBounds="True">
                <Border Width="{Binding InspectorNameColumnWidth}"
                        Background="#24242A"/>
                  <Border Grid.Column="1"
                          Background="Transparent"
                        Cursor="SizeWestEast"
                        PointerPressed="OnInspectorGripPressed"
                        PointerMoved="OnInspectorGripMoved"
                        PointerReleased="OnInspectorGripReleased"
                        ZIndex="10">
                    <Border Width="1"
                            Background="#3A3A40"
                            HorizontalAlignment="Center"/>
                  </Border>
                  <Border Grid.Column="2"
                          Background="#17181B"/>
                  <ListBox x:Name="VariationInspectorNameList"
                           Grid.Column="0"
                           Classes="inspector-name-list"
                           Width="{Binding InspectorNameColumnWidth}"
                           ItemsSource="{Binding VariationVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorNameTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                  <ListBox x:Name="VariationInspectorValueList"
                           Grid.Column="2"
                           Classes="inspector-list"
                           ItemsSource="{Binding VariationVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorValueTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Mesh">
            <Grid RowDefinitions="Auto,*" Margin="0,6,0,0">
              <TextBox Classes="search-box"
                       Watermark="Filter"
                       Margin="0,0,0,6"
                       Text="{Binding MeshFilterText, Mode=TwoWay}"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,8,*" ClipToBounds="True">
                <Border Width="{Binding InspectorNameColumnWidth}"
                        Background="#24242A"/>
                  <Border Grid.Column="1"
                          Background="Transparent"
                        Cursor="SizeWestEast"
                        PointerPressed="OnInspectorGripPressed"
                        PointerMoved="OnInspectorGripMoved"
                        PointerReleased="OnInspectorGripReleased"
                        ZIndex="10">
                    <Border Width="1"
                            Background="#3A3A40"
                            HorizontalAlignment="Center"/>
                  </Border>
                  <Border Grid.Column="2"
                          Background="#17181B"/>
                  <ListBox x:Name="MeshInspectorNameList"
                           Grid.Column="0"
                           Classes="inspector-name-list"
                           Width="{Binding InspectorNameColumnWidth}"
                           ItemsSource="{Binding MeshInspectorVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorNameTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                  <ListBox x:Name="MeshInspectorValueList"
                           Grid.Column="2"
                           Classes="inspector-list"
                           ItemsSource="{Binding MeshInspectorVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorValueTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Scene">
            <Grid RowDefinitions="Auto,*" Margin="0,6,0,0">
              <TextBox Classes="search-box"
                       Watermark="Filter"
                       Margin="0,0,0,6"
                       Text="{Binding SceneFilterText, Mode=TwoWay}"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,8,*" ClipToBounds="True">
                <Border Width="{Binding InspectorNameColumnWidth}"
                        Background="#24242A"/>
                  <Border Grid.Column="1"
                          Background="Transparent"
                        Cursor="SizeWestEast"
                        PointerPressed="OnInspectorGripPressed"
                        PointerMoved="OnInspectorGripMoved"
                        PointerReleased="OnInspectorGripReleased"
                        ZIndex="10">
                    <Border Width="1"
                            Background="#3A3A40"
                            HorizontalAlignment="Center"/>
                  </Border>
                  <Border Grid.Column="2"
                          Background="#17181B"/>
                  <ListBox x:Name="SceneInspectorNameList"
                           Grid.Column="0"
                           Classes="inspector-name-list"
                           Width="{Binding InspectorNameColumnWidth}"
                           ItemsSource="{Binding SceneVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorNameTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                  <ListBox x:Name="SceneInspectorValueList"
                           Grid.Column="2"
                           Classes="inspector-list"
                           ItemsSource="{Binding SceneVisibleNodes}"
                           ItemTemplate="{StaticResource InspectorValueTemplate}"
                           ScrollViewer.AllowAutoHide="True"
                           ScrollViewer.IsScrollInertiaEnabled="False"
                           ScrollViewer.IsScrollChainingEnabled="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
        </Grid>
      </Border>
  </Grid>
</UserControl>
