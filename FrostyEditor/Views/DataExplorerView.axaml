<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FrostyEditor.ViewModels"
             xmlns:models="clr-namespace:FrostyEditor.Models"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="800"
             x:Class="FrostyEditor.Views.DataExplorerView"
             x:DataType="viewModels:DataExplorerViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="ToggleButton.explorer-tab-toggle">
      <Setter Property="Background" Value="#1F1F23"/>
      <Setter Property="BorderBrush" Value="#34343A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,1,0"/>
      <Setter Property="MinWidth" Value="118"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ToggleButton.explorer-tab-toggle:checked">
      <Setter Property="Background" Value="#3C3C41"/>
      <Setter Property="BorderBrush" Value="#62626A"/>
    </Style>

    <Style Selector="Border.explorer-counter-strip">
      <Setter Property="Background" Value="#202025"/>
      <Setter Property="BorderBrush" Value="#35353B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style Selector="Border.explorer-filter-strip">
      <Setter Property="Background" Value="#19191C"/>
      <Setter Property="BorderBrush" Value="#323238"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style Selector="ComboBox.explorer-filter-combo">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="10,0,24,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="Transparent"/>
    </Style>

    <Style Selector="ComboBox.explorer-filter-combo /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="Transparent"/>
    </Style>

    <Style Selector="ComboBox.explorer-filter-combo /template/ PathIcon">
      <Setter Property="Foreground" Value="Transparent"/>
    </Style>

    <Style Selector="ComboBox.explorer-filter-combo /template/ Popup#PART_Popup">
      <Setter Property="Placement" Value="BottomEdgeAlignedLeft"/>
      <Setter Property="HorizontalOffset" Value="0"/>
    </Style>

    <Style Selector="Border.explorer-filter-strip TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Image.explorer-filter-icon">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Height" Value="11"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.explorer-filter-label">
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBox.explorer-header-input">
      <Setter Property="Height" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Grid.explorer-inline-search Image">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <Style Selector="CheckBox.explorer-filter-check">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="Padding" Value="2,0,0,0"/>
      <Setter Property="Margin" Value="2,0,2,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="FolderNameCell"
                  x:DataType="models:FolderTreeNodeModel">
      <StackPanel Orientation="Horizontal" Margin="1,0,1,0">
        <Image Source="{Binding FolderIcon}"
               Width="16"
               Height="16"
               Margin="0 0 4 0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AssetNameCell"
                  x:DataType="models:AssetModel">
      <StackPanel Orientation="Horizontal" Margin="1,0,1,0" Spacing="4">
        <Image Source="{Binding Icon}"
               Width="16"
               Height="16"
               VerticalAlignment="Center"/>
        <TextBlock VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   FontWeight="{Binding NameFontWeight}">
          <Run Text="{Binding Name}"/>
          <Run Text="{Binding DirtySuffix}"/>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LegacyFolderNameCell"
                  x:DataType="models:LegacyFolderTreeNodeModel">
      <StackPanel Orientation="Horizontal" Margin="1,0,1,0">
        <Image Source="{Binding FolderIcon}"
               Width="16"
               Height="16"
               Margin="0 0 4 0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LegacyAssetNameCell"
                  x:DataType="models:LegacyAssetModel">
      <StackPanel Orientation="Horizontal" Margin="1,0,1,0" Spacing="4">
        <Image Source="{Binding Icon}"
               Width="16"
               Height="16"
               VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*" Margin="0">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,0">
      <ToggleButton Grid.Column="0"
                    Classes="explorer-tab-toggle"
                    IsChecked="{Binding IsDataExplorerSelected}"
                    Command="{Binding ShowDataExplorerTabCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Database.png"
                 Width="14"
                 Height="14"
                 VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
        </StackPanel>
      </ToggleButton>

      <ToggleButton Grid.Column="1"
                    Classes="explorer-tab-toggle"
                    IsChecked="{Binding IsLegacyExplorerSelected}"
                    Command="{Binding ShowLegacyExplorerTabCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Database.png"
                 Width="14"
                 Height="14"
                 VerticalAlignment="Center"/>
          <TextBlock Text="{Binding LegacyExplorer.Title}" VerticalAlignment="Center"/>
        </StackPanel>
      </ToggleButton>

      <Button Grid.Column="3"
              Classes="quick-icon"
              Width="24"
              Height="20"
              Margin="8,0,0,0"
              VerticalAlignment="Bottom"
              Click="OnToggleDockClicked"
              ToolTip.Tip="Dock or Undock Explorer">
        <TextBlock Text="[]"
                   FontFamily="Consolas"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
      </Button>
    </Grid>

    <Border Grid.Row="1" Classes="explorer-filter-strip" Margin="0,-1,0,2">
      <Grid>
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" MinHeight="22" IsVisible="{Binding IsDataExplorerSelected}">
          <Image Grid.Column="0"
                 Classes="explorer-filter-icon"
                 Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/OpenFolder.png"/>
          <TextBlock Grid.Column="1" Classes="explorer-filter-label" Text="Show Only:"/>
          <CheckBox Grid.Column="2" Classes="explorer-filter-check" Content="Modified" IsChecked="{Binding ShowModifiedOnly}"/>
          <CheckBox Grid.Column="3" Classes="explorer-filter-check" Content="Unmodified" IsChecked="{Binding ShowUnmodifiedOnly}"/>
          <CheckBox Grid.Column="4" Classes="explorer-filter-check" Content="Unsaved" IsChecked="{Binding ShowUnsavedOnly}"/>
          <CheckBox Grid.Column="5" Classes="explorer-filter-check" Content="Added" IsChecked="{Binding ShowAddedOnly}"/>
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" MinHeight="22" IsVisible="{Binding IsLegacyExplorerSelected}">
          <Image Grid.Column="0"
                 Classes="explorer-filter-icon"
                 Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/OpenFolder.png"/>
          <TextBlock Grid.Column="1" Classes="explorer-filter-label" Text="Show Only:"/>
          <CheckBox Grid.Column="2" Classes="explorer-filter-check" Content="Modified" IsChecked="{Binding LegacyExplorer.ShowModifiedOnly}"/>
          <CheckBox Grid.Column="3" Classes="explorer-filter-check" Content="Unmodified" IsChecked="{Binding LegacyExplorer.ShowUnmodifiedOnly}"/>
          <CheckBox Grid.Column="4" Classes="explorer-filter-check" Content="Unsaved" IsChecked="{Binding LegacyExplorer.ShowUnsavedOnly}"/>
          <CheckBox Grid.Column="5" Classes="explorer-filter-check" Content="Added" IsChecked="{Binding LegacyExplorer.ShowAddedOnly}"/>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid x:Name="ExplorerGrid"
            IsVisible="{Binding IsDataExplorerSelected}"
            RowDefinitions="Auto,Auto,2.25*,2,*">
        <Grid x:Name="DataTypeFilterRow" Grid.Row="0" ColumnDefinitions="*,140" Margin="0,0,0,2" MinHeight="28">
          <Grid Grid.Column="0">
            <ComboBox x:Name="DataTypeCombo"
                      Classes="explorer-filter-combo"
                      Margin="0"
                      Width="{Binding AssetTypeComboMinWidth}"
                      ItemsSource="{Binding AvailableAssetTypes}"
                      SelectedItem="{Binding SelectedAssetTypeFilter}"
                      DropDownOpened="TypeCombo_OnDropDownOpened">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding .}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SelectedAssetTypeFilterDisplay}"
                       Margin="10,0,24,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="White"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="▼"
                       Margin="0,0,9,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       IsHitTestVisible="False"
                       Foreground="White"
                       FontSize="10"/>
          </Grid>
          <TextBox x:Name="DataTypeFilterTextBox"
                   Grid.Column="1"
                   Classes="search-box explorer-header-input"
                   Margin="4,0,0,0"
                   Watermark="Filter types"
                   TextChanged="TypeFilterTextBox_OnTextChanged"
                   Text="{Binding AssetTypeSearchText}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*" Margin="0,0,0,2" MinHeight="28">
          <Grid Grid.Column="0" Classes="explorer-inline-search">
            <TextBox x:Name="DataSearchBox"
                     Classes="search-box explorer-header-input"
                     Margin="0"
                     Watermark="Search Assets"
                     Text="{Binding FilterText}"
                     Padding="26,0,8,0" />
            <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Filter.png"
                    Width="12"
                    Height="12"
                   Margin="8,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
          </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="panel" Padding="1">
          <TreeDataGrid x:Name="FolderTree"
                        Margin="0"
                        Source="{Binding FolderSource}"
                        ContextFlyout="{Binding FolderContextMenu, Mode=OneWay}"
                        PointerPressed="FolderTree_OnPointerPressed"
                        Tapped="FolderTree_OnTapped"
                        DoubleTapped="FolderTree_OnDoubleTapped"/>
        </Border>

        <GridSplitter Grid.Row="3"
                      Height="2"
                      Background="#3B3B3B"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"/>

        <Border Grid.Row="4" Classes="panel" Padding="1">
          <Grid RowDefinitions="*">
            <TreeDataGrid x:Name="AssetsTree"
                          Grid.Row="0"
                          Margin="0"
                          Source="{Binding AssetsSource}"
                          ContextFlyout="{Binding AssetContextMenu, Mode=OneWay}"
                          PointerPressed="AssetsTree_OnPointerPressed"
                          DoubleTapped="AssetsTree_OnDoubleTapped"/>
          </Grid>
        </Border>
      </Grid>

      <Grid IsVisible="{Binding IsLegacyExplorerSelected}"
            RowDefinitions="Auto,Auto,2.25*,2,*">
        <Grid x:Name="LegacyTypeFilterRow" Grid.Row="0" ColumnDefinitions="*,140" Margin="0,0,0,2" MinHeight="28">
          <Grid Grid.Column="0">
            <ComboBox x:Name="LegacyTypeCombo"
                      Classes="explorer-filter-combo"
                      Margin="0"
                      Width="{Binding LegacyExplorer.AssetTypeComboMinWidth}"
                      ItemsSource="{Binding LegacyExplorer.AvailableAssetTypes}"
                      SelectedItem="{Binding LegacyExplorer.SelectedAssetTypeFilter}"
                      DropDownOpened="TypeCombo_OnDropDownOpened">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding .}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding LegacyExplorer.SelectedAssetTypeFilterDisplay}"
                       Margin="10,0,24,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="White"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="▼"
                       Margin="0,0,9,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       IsHitTestVisible="False"
                       Foreground="White"
                       FontSize="10"/>
          </Grid>
          <TextBox x:Name="LegacyTypeFilterTextBox"
                    Grid.Column="1"
                    Classes="search-box explorer-header-input"
                    Margin="4,0,0,0"
                    Watermark="Filter types"
                    TextChanged="LegacyTypeFilterTextBox_OnTextChanged"
                   Text="{Binding LegacyExplorer.AssetTypeSearchText}"
                   IsEnabled="{Binding LegacyExplorer.HasAssets}"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*" Margin="0,0,0,2" MinHeight="28">
          <Grid Grid.Column="0" Classes="explorer-inline-search">
            <TextBox x:Name="LegacySearchBox"
                     Classes="search-box explorer-header-input"
                     Margin="0"
                     Watermark="Search Assets"
                     Text="{Binding LegacyExplorer.FilterText}"
                     Padding="26,0,8,0"
                     IsEnabled="{Binding LegacyExplorer.HasAssets}"/>
            <Image Source="avares://FrostyEditor/Assets/Legacy/FrostyEditorImages/Filter.png"
                   Width="12"
                   Height="12"
                   Margin="8,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
          </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="panel" Padding="1" IsVisible="{Binding LegacyExplorer.ShowExplorer}">
          <TreeDataGrid x:Name="LegacyFolderTree"
                        Margin="0"
                        Source="{Binding LegacyExplorer.FolderSource}"
                        ContextFlyout="{Binding LegacyExplorer.FolderContextMenu, Mode=OneWay}"
                        PointerPressed="LegacyFolderTree_OnPointerPressed"
                        Tapped="LegacyFolderTree_OnTapped"
                        DoubleTapped="LegacyFolderTree_OnDoubleTapped"/>
        </Border>

        <GridSplitter Grid.Row="3"
                      Height="2"
                      Background="#3B3B3B"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      IsVisible="{Binding LegacyExplorer.ShowExplorer}"/>

        <Border Grid.Row="4" Classes="panel" Padding="1" IsVisible="{Binding LegacyExplorer.ShowExplorer}">
          <Grid RowDefinitions="*">
            <TreeDataGrid x:Name="LegacyAssetsTree"
                          Grid.Row="0"
                          Margin="0"
                          Source="{Binding LegacyExplorer.AssetsSource}"
                          ContextFlyout="{Binding LegacyExplorer.AssetContextMenu, Mode=OneWay}"
                          PointerPressed="LegacyAssetsTree_OnPointerPressed"
                          DoubleTapped="LegacyAssetsTree_OnDoubleTapped"/>
          </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.RowSpan="3"
                Classes="panel"
                Padding="12"
                IsVisible="{Binding LegacyExplorer.ShowMessagePanel}">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Text="{Binding LegacyExplorer.Title}" Classes="section-title"/>
            <TextBlock Grid.Row="1"
                       Text="{Binding LegacyExplorer.Status}"
                       Classes="subtle"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
            <Border Grid.Row="2" Classes="panel" Margin="0,12,0,0" Padding="12">
              <TextBlock Text="{Binding LegacyExplorer.Details}"
                         Classes="subtle"
                         TextWrapping="Wrap"/>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
