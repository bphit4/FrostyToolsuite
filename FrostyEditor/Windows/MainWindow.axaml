<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:FrostyEditor.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FrostyEditor.Windows.MainWindow"
        x:CompileBindings="True"
        Icon="/Assets/FrostyApp.ico"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="56"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="Frosty Editor 2.0">
  <Border Background="#1F1F23"
          BorderBrush="#2A2A2E"
          BorderThickness="0,0,0,1">
    <Grid x:Name="ShellHost" Background="#1F1F23">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="18,12"
              Background="#2B2B30"
              BorderBrush="#4A4A50"
              BorderThickness="1"
              CornerRadius="6">
        <TextBlock Text="Loading editor shell..."
                   FontSize="14"
                   Foreground="#F2F2F2"/>
      </Border>
    </Grid>
  </Border>
</Window>
